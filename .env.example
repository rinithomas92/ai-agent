PORT=8080
PUBLIC_BASE_URL=http://localhost:8080


# OpenAI quote generation. Leave empty to use demo/mock copy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# xAI/Grok media generation. Leave empty to use the local quote-card renderer only.
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image-quality
XAI_VIDEO_MODEL=grok-imagine-video-1.5

# Instagram Graph API. Requires an Instagram professional account connected to a Facebook Page.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_GRAPH_VERSION=v23.0

# Scheduler timezone and default posting time.
SCHEDULER_TIMEZONE=Asia/Kolkata
DEFAULT_POST_TIME=09:00
