# Runtime behaviour:
# - true: force Demo Mode and make no external API calls, even if keys exist.
# - auto or false: use each live service when its credentials exist; otherwise
#   automatically keep that service in Demo Mode.
DEMO_MODE=auto
MAX_POSTS_PER_DAY=10

# Add an OpenAI key to switch post generation/regeneration from Demo content to live AI.
# Keep DEMO_MODE=auto (or false) when you want the key to be used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

XAI_API_KEY=
XAI_IMAGE_MODEL=

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_GRAPH_VERSION=v23.0
